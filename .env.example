# ==============================================================================
# Nexus-Flow Environment Configuration Template (.env.example)
# Autonomous Procurement & Financial Orchestration Protocol
# PayPal & AI Hackathon 2026
# ==============================================================================

# Application Runtime
APP_ENV=development
DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8000

# Security & Cryptography (Generate a cryptographically secure random secret)
JWT_SECRET_KEY=generate-a-secure-random-256-bit-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,https://nexusflow.network

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=120

# PayPal Commerce Platform & Orders v2 Sandbox Credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=sandbox_nexus_client_id_2026_demo
PAYPAL_CLIENT_SECRET=sandbox_nexus_secret_key_2026_demo
PAYPAL_BN_CODE=NexusFlow_SPB_2026
PAYPAL_PARTNER_ATTRIBUTION_ID=NexusFlow_Marketplace_BOM
PAYPAL_WEBHOOK_ID=WH-9928374615284758
PAYPAL_SANDBOX_BASE_URL=https://api-m.sandbox.paypal.com

# Channel3 B2B Catalog Provider
CHANNEL3_API_KEY=
CHANNEL3_ENDPOINT=https://api.channel3.io/v1/catalogs
CHANNEL3_MOCK_FALLBACK=true

# Kernel Web Sourcing Agent
KERNEL_API_KEY=
KERNEL_ENDPOINT=https://api.kernel.sh/v1/agent/crawl
KERNEL_MOCK_FALLBACK=true

# APIMatic Schema Validation
APIMATIC_VALIDATION_ENABLED=true
APIMATIC_SCHEMA_URL=https://api.nexusflow.network/schemas/paypal-commerce-v2.json
APIMATIC_STRICT_MODE=true

# Platform Economics & Multi-Vendor Split Parameters
PLATFORM_FEE_PERCENTAGE=2.50
ESCROW_HOLD_HOURS=72
SETTLEMENT_CURRENCY=USD
